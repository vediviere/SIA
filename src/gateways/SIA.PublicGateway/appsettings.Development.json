{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "admin-bff-academic-planning": {
        "ClusterId": "admin-bff",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/academic-planning/{**catch-all}"
        }
      },
      "admin-bff-openapi": {
        "ClusterId": "admin-bff",
        "Match": {
          "Path": "/admin-bff/openapi/v1.json"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/admin-bff"
          },
          {
            "RequestHeaderOriginalHost": true
          }
        ]
      }
    },
    "Clusters": {
      "admin-bff": {
        "Destinations": {
          "admin-bff-primary": {
            "Address": "https://localhost:7101/"
          }
        }
      }
    }
  }
}
