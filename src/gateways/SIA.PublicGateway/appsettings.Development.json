{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "admin-bff-academic-planning": {
        "ClusterId": "admin-bff",
        "Match": {
          "Path": "/api/academic-planning/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin-bff": {
        "Destinations": {
          "admin-bff-primary": {
            "Address": "https://localhost:7101/"
          }
        }
      }
    }
  }
}